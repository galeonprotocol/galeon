#!/usr/bin/env sh
# Block pushes that would publish private material in this public repo:
# business documents (spreadsheets, Word, slides), the outputs/ folder,
# funding applications, or commits from the history rewritten on 21 Nov 2026.
# Private documents belong in the private ops repository.

blocked='(^|/)outputs/|\.(xlsx|xls|docx|doc|pptx|ppt)$|(^|/)docs/applications/|(^|/)(BUDGET|ONE-PAGER)\.md$|APPLICATION\.md$|SUBMISSION-FORM\.md$'
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  hits=$(git log --format= --name-only "$local_sha" --not --remotes=origin 2>/dev/null | sort -u | grep -E "$blocked")
  if [ -n "$hits" ]; then
    echo "pre-push: blocked push of $local_ref. These paths must not be published:" >&2
    echo "$hits" | sed 's/^/  /' >&2
    echo "Move them to the private ops repo. If this branch predates the 21 Nov 2026 history rewrite, rebase it onto origin/main first." >&2
    status=1
  fi
done

exit $status
